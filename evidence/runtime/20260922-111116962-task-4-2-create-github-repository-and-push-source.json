-head{align-items:stretch;flex-direction:column}.page-head .btn{justify-content:center}.rca-grid{grid-template-columns:1fr}.account-banner{align-items:flex-start;gap:15px;flex-direction:column}.account-id{text-align:left}.quick{grid-template-columns:1fr 1fr}}\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to main content</a>\n<div class=\"app\">\n<aside class=\"sidebar\" id=\"sidebar\" aria-label=\"Primary navigation\">\n<div class=\"brand\"><div class=\"brand-mark\">CP</div><div><strong>Customer Portal</strong><span class=\"prototype\">Prototype</span></div></div>\n<div class=\"nav-label\">Portal</div>\n<nav class=\"nav\">\n<button class=\"active\" data-view=\"overview\"><span class=\"icon\">⌂</span>Overview</button>\n<button data-view=\"accounts\"><span class=\"icon\">▣</span>Accounts</button>\n<button data-view=\"documents\"><span class=\"icon\">▤</span>Documents</button>\n<button data-view=\"support\"><span class=\"icon\">◉</span>Support</button>\n<button data-view=\"profile\"><span class=\"icon\">♙</span>Profile</button>\n</nav>\n<div class=\"nav-label\">Operations</div>\n<nav class=\"nav\"><button data-view=\"delivery\"><span class=\"icon\">↗</span>Delivery status</button></nav>\n<div class=\"side-footer\"><div class=\"status-line\"><span class=\"dot\"></span>All customer services operational</div></div>\n</aside>\n<main class=\"main\" id=\"main\">\n<header class=\"topbar\"><button class=\"mobile-menu\" id=\"menuBtn\" aria-label=\"Open navigation\">☰</button><div class=\"search\"><span>⌕</span><input id=\"globalSearch\" type=\"search\" placeholder=\"Search documents, requests, accounts…\" aria-label=\"Search portal\"></div><div class=\"user\"><button class=\"btn small\" id=\"notifyBtn\" aria-label=\"Notifications\">● <span class=\"pill red\">2</span></button><div class=\"avatar\">AM</div><div class=\"user-meta\"><strong>Alex Morgan</strong><small>Northwind Group</small></div></div></header>\n<div class=\"content\">\n<section class=\"view active\" id=\"overview\">\n<div class=\"page-head\"><div><h1>Good morning, Alex</h1><p>Here is what is happening with your account today.</p></div><button class=\"btn primary open-ticket\">＋ New support request</button></div>\n<div class=\"grid stats\">\n<div class=\"card stat\"><div class=\"stat-top\"><span>Account balance</span><span class=\"stat-icon\">$</span></div><div class=\"stat-value\">$12,480.00</div><div class=\"stat-note\">Paid through June 30</div></div>\n<div class=\"card stat\"><div class=\"stat-top\"><span>Open requests</span><span class=\"stat-icon\">?</span></div><div class=\"stat-value\">3</div><div class=\"stat-note\">1 updated today</div></div>\n<div class=\"card stat\"><div class=\"stat-top\"><span>Documents</span><span class=\"stat-icon\">▤</span></div><div class=\"stat-value\">24</div><div class=\"stat-note\">2 new this month</div></div>\n<div class=\"card stat\"><div class=\"stat-top\"><span>Profile security</span><span class=\"stat-icon\">✓</span></div><div class=\"stat-value\">Strong</div><div class=\"stat-note\">MFA is enabled</div></div>\n</div>\n<div class=\"grid cols\">\n<div class=\"card\"><div class=\"card-head\"><h2>Account summary</h2><button class=\"btn small nav-link\" data-view=\"accounts\">View account</button></div><div class=\"card-body\"><div class=\"account-banner\"><div><small>Available service credit</small><strong>$7,520.00</strong></div><div class=\"account-id\"><span>Customer number</span><b>NW-2048-73</b></div></div><div class=\"progress-row\"><span>Plan usage</span><div class=\"bar\"><i style=\"width:68%\"></i></div><b>68%</b></div><div class=\"progress-row\"><span>Storage</span><div class=\"bar\"><i style=\"width:42%\"></i></div><b>42%</b></div><div class=\"progress-row\"><span>Team seats</span><div class=\"bar\"><i style=\"width:80%\"></i></div><b>80%</b></div></div></div>\n<div class=\"grid\"><div class=\"card\"><div class=\"card-head\"><h2>Quick actions</h2></div><div class=\"card-body quick\"><button class=\"open-ticket\"><b>＋</b>Get support</button><button class=\"nav-link\" data-view=\"documents\"><b>⇩</b>Documents</button><button class=\"nav-link\" data-view=\"profile\"><b>♙</b>Edit profile</button><button id=\"paymentBtn\"><b>$</b>Make payment</button></div></div><div class=\"notice\"><strong>Scheduled maintenance</strong><br>Document services may be briefly unavailable Sunday from 02:00–03:00 UTC.</div></div>\n</div>\n<div class=\"card\" style=\"margin-top:18px\"><div class=\"card-head\"><h2>Recent activity</h2><button class=\"btn small nav-link\" data-view=\"support\">View all</button></div><div class=\"card-body\"><ul class=\"activity\"><li><span class=\"activity-icon\">✓</span><div><strong>Invoice INV-10482 paid</strong><small>Payment confirmed successfully</small></div><time>Today, 9:42</time></li><li><span class=\"activity-icon\">↻</span><div><strong>Support request updated</strong><small>SR-2841 · Access permissions</small></div><time>Yesterday</time></li><li><span class=\"activity-icon\">▤</span><div><strong>New statement available</strong><small>May 2025 account statement</small></div><time>Jun 2</time></li></ul></div></div>\n</section>\n<section class=\"view\" id=\"accounts\"><div class=\"page-head\"><div><h1>Accounts</h1><p>Review subscriptions, usage, and billing details.</p></div><button class=\"btn primary\" id=\"payTop\">Make a payment</button></div><div class=\"card table-card\"><div class=\"card-head\"><h2>Active services</h2><span class=\"pill green\">Account in good standing</span></div><div class=\"table-wrap\"><table><thead><tr><th>Service</th><th>Plan</th><th>Renewal</th><th>Monthly cost</th><th>Status</th></tr></thead><tbody><tr><td><strong>Customer Platform</strong><br><small>CP-4732</small></td><td>Enterprise</td><td>Jul 1, 2025</td><td>$1,240.00</td><td><span class=\"pill green\">Active</span></td></tr><tr><td><strong>Secure Storage</strong><br><small>SS-8821</small></td><td>2 TB</td><td>Jul 1, 2025</td><td>$320.00</td><td><span class=\"pill green\">Active</span></td></tr><tr><td><strong>Advanced Analytics</strong><br><small>AA-1029</small></td><td>Professional</td><td>Jul 1, 2025</td><td>$180.00</td><td><span class=\"pill amber\">Review</span></td></tr></tbody></table></div></div></section>\n<section class=\"view\" id=\"documents\"><div class=\"page-head\"><div><h1>Documents</h1><p>Securely access statements, invoices, and agreements.</p></div><button class=\"btn\">Filter documents</button></div><div class=\"grid doc-grid\"><article class=\"card doc\"><div class=\"doc-icon\">PDF</div><h3>May 2025 Statement</h3><p>Account statement · 842 KB · Jun 2, 2025</p><button class=\"btn small download\">⇩ Download</button></article><article class=\"card doc\"><div class=\"doc-icon\">PDF</div><h3>Invoice INV-10482</h3><p>Invoice · 324 KB · May 28, 2025</p><button class=\"btn small download\">⇩ Download</button></article><article class=\"card doc\"><div class=\"doc-icon\">DOC</div><h3>Service Agreement</h3><p>Agreement · 1.2 MB · Jan 12, 2025</p><button class=\"btn small download\">⇩ Download</button></article><article class=\"card doc\"><div class=\"doc-icon\">PDF</div><h3>April 2025 Statement</h3><p>Account statement · 811 KB · May 2, 2025</p><button class=\"btn small download\">⇩ Download</button></article></div></section>\n<section class=\"view\" id=\"support\"><div class=\"page-head\"><div><h1>Support requests</h1><p>Create and track requests with the customer care team.</p></div><button class=\"btn primary open-ticket\">＋ New request</button></div><div class=\"card table-card\"><div class=\"table-wrap\"><table><thead><tr><th>Reference</th><th>Subject</th><th>Last update</th><th>Priority</th><th>Status</th></tr></thead><tbody id=\"ticketRows\"><tr><td><strong>SR-2841</strong></td><td>Access permissions for new team member</td><td>Today, 10:18</td><td>Normal</td><td><span class=\"pill blue\">In progress</span></td></tr><tr><td><strong>SR-2793</strong></td><td>Billing address update</td><td>May 30, 2025</td><td>Low</td><td><span class=\"pill green\">Resolved</span></td></tr><tr><td><strong>SR-2761</strong></td><td>Document export question</td><td>May 27, 2025</td><td>Normal</td><td><span class=\"pill amber\">Waiting on you</span></td></tr></tbody></table></div></div></section>\n<section class=\"view\" id=\"profile\"><div class=\"page-head\"><div><h1>Profile & security</h1><p>Manage your personal details and sign-in preferences.</p></div></div><div class=\"grid profile-grid\"><form class=\"card form-card\" id=\"profileForm\"><h2>Personal information</h2><div class=\"field\"><label for=\"name\">Full name</label><input id=\"name\" value=\"Alex Morgan\"></div><div class=\"field\"><label for=\"email\">Email address</label><input id=\"email\" type=\"email\" value=\"alex.morgan@example.com\"></div><div class=\"field\"><label for=\"phone\">Phone number</label><input id=\"phone\" value=\"+1 (555) 014-8290\"></div><div class=\"field\"><label for=\"company\">Organization</label><input id=\"company\" value=\"Northwind Group\"></div><button class=\"btn primary\" type=\"submit\">Save changes</button></form><div class=\"card form-card\"><h2>Sign-in security</h2><div class=\"activity\"><li><span class=\"activity-icon\">✓</span><div><strong>Multi-factor authentication</strong><small>Enabled with Microsoft Authenticator</small></div><span class=\"pill green\">On</span></li><li><span class=\"activity-icon\">⌁</span><div><strong>Password</strong><small>Last changed 42 days ago</small></div><button class=\"btn small\" id=\"passwordBtn\">Change</button></li><li><span class=\"activity-icon\">↗</span><div><strong>Active sessions</strong><small>2 recognized devices</small></div><button class=\"btn small\" id=\"sessionsBtn\">Review</button></li></div></div></div></section>\n<section class=\"view\" id=\"delivery\"><div class=\"page-head\"><div><h1>Delivery status</h1><p>Prototype release diagnostics for the Azure App Service deployment.</p></div><span class=\"pill amber\">Staging investigation</span></div><div class=\"card pipeline\"><div class=\"card-head\" style=\"padding:0 0 16px\"><h2>Release customer-portal / a81d9c2</h2><span>Started 10:04 UTC</span></div><div class=\"steps\"><div class=\"step done\"><strong>✓ Build</strong>Passed · 2m 14s</div><div class=\"step done\"><strong>✓ Security checks</strong>Passed · 1m 08s</div><div class=\"step done\"><strong>✓ Infrastructure</strong>Passed · 3m 41s</div><div class=\"step failed\" id=\"deployStep\"><strong>✕ App startup</strong>Failed · 4m 02s</div><div class=\"step\"><strong>— Smoke tests</strong>Not started</div></div><div class=\"rca\"><h3>Root cause identified</h3><div class=\"rca-grid\"><div class=\"rca-item\"><strong>Failure</strong>Application health check returned HTTP 503 after deployment.</div><div class=\"rca-item\"><strong>Root cause</strong>App Service runtime was set to Node 18 while the build requires Node 20.</div><div class=\"rca-item\"><strong>Corrective action</strong>Update the runtime setting to Node 20 LTS and restart the staging slot.</div><div class=\"rca-item\"><strong>Prevention</strong>Add a runtime compatibility check before deployment.</div></div><button class=\"btn primary\" id=\"applyFix\" style=\"margin-top:17px\">Apply fix and verify</button><div class=\"success-box\" id=\"fixSuccess\"><strong>Verification passed.</strong> Runtime updated, health endpoint returned HTTP 200, and smoke tests completed successfully.</div></div></div></section>\n</div>\n</main>\n</div>\n<div class=\"modal-backdrop\" id=\"ticketModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ticketTitle\"><div class=\"modal\"><div class=\"modal-head\"><h2 id=\"ticketTitle\">New support request</h2><button class=\"close\" aria-label=\"Close\">×</button></div><form id=\"ticketForm\"><div class=\"modal-body\"><div class=\"field\"><label for=\"subject\">Subject</label><input id=\"subject\" required placeholder=\"Briefly describe your request\"></div><div class=\"field\"><label for=\"category\">Category</label><select id=\"category\"><option>Account access</option><option>Billing</option><option>Technical issue</option><option>Documents</option><option>Other</option></select></div><div class=\"field\"><label for=\"priority\">Priority</label><select id=\"priority\"><option>Low</option><option selected>Normal</option><option>High</option></select></div><div class=\"field\"><label for=\"details\">Details</label><textarea id=\"details\" required placeholder=\"Include any relevant details. Do not include passwords or secrets.\"></textarea></div></div><div class=\"modal-actions\"><button class=\"btn close-modal\" type=\"button\">Cancel</button><button class=\"btn primary\" type=\"submit\">Submit request</button></div></form></div></div>\n<div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<script>\nconst views=document.querySelectorAll('.view'),navButtons=document.querySelectorAll('.nav button[data-view]'),sidebar=document.getElementById('sidebar');\nfunction showView(id){views.forEach(v=>v.classList.toggle('active',v.id===id));navButtons.forEach(b=>b.classList.toggle('active',b.dataset.view===id));sidebar.classList.remove('open');window.scrollTo({top:0,behavior:'smooth'});}\ndocument.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));\ndocument.getElementById('menuBtn').addEventListener('click',()=>sidebar.classList.toggle('open'));\nconst modal=document.getElementById('ticketModal');\nfunction openModal(){modal.classList.add('open');setTimeout(()=>document.getElementById('subject').focus(),50)}\nfunction closeModal(){modal.classList.remove('open')}\ndocument.querySelectorAll('.open-ticket').forEach(b=>b.addEventListener('click',openModal));document.querySelector('.close').addEventListener('click',closeModal);document.querySelector('.close-modal').addEventListener('click',closeModal);modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});\nfunction toast(message){const t=document.getElementById('toast');t.textContent=message;t.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.classList.remove('show'),2800)}\ndocument.getElementById('ticketForm').addEventListener('submit',e=>{e.preventDefault();const subject=document.getElementById('subject').value,priority=document.getElementById('priority').value,id='SR-'+Math.floor(3000+Math.random()*600);document.getElementById('ticketRows').insertAdjacentHTML('afterbegin','<tr><td><strong>'+id+'</strong></td><td>'+subject.replace(/[<>]/g,'')+'</td><td>Just now</td><td>'+priority+'</td><td><span class=\"pill blue\">Submitted</span></td></tr>');e.target.reset();closeModal();showView('support');toast('Support request '+id+' created successfully')});\ndocument.getElementById('profileForm').addEventListener('submit',e=>{e.preventDefault();toast('Profile changes saved')});\ndocument.querySelectorAll('.download').forEach(b=>b.addEventListener('click',()=>toast('Secure download prepared (prototype)')));\n['paymentBtn','payTop'].forEach(id=>document.getElementById(id).addEventListener('click',()=>toast('Payment flow opened (prototype)')));\ndocument.getElementById('notifyBtn').addEventListener('click',()=>toast('You have 2 account notifications'));\ndocument.getElementById('passwordBtn').addEventListener('click',()=>toast('Password management opened (prototype)'));document.getElementById('sessionsBtn').addEventListener('click',()=>toast('Session review opened (prototype)'));\ndocument.getElementById('applyFix').addEventListener('click',function(){this.disabled=true;this.textContent='Verifying…';setTimeout(()=>{const s=document.getElementById('deployStep');s.className='step done';s.innerHTML='<strong>✓ App startup</strong>Passed after fix · 1m 22s';document.getElementById('fixSuccess').style.display='block';this.textContent='Fix verified';toast('Staging deployment recovered successfully')},1300)});\ndocument.getElementById('globalSearch').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();toast(e.target.value?'Searching for “'+e.target.value+'” (prototype)':'Enter a search term')}});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();sidebar.classList.remove('open')}});\n</script>\n</body>\n</html>"
