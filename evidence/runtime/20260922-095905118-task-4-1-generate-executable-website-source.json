gin-bottom:6px}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:#fff}.field.full{grid-column:1/-1}.notice{padding:13px 15px;border-radius:9px;background:#eff6ff;color:#174f91;font-size:13px;margin-bottom:18px}.toast{position:fixed;right:25px;bottom:25px;background:#10233f;color:#fff;border-radius:10px;padding:13px 17px;box-shadow:var(--shadow);transform:translateY(90px);opacity:0;transition:.25s;z-index:20}.toast.show{transform:none;opacity:1}.mobile-overlay{display:none}\n@media(max-width:1050px){.stats{grid-template-columns:1fr 1fr}.dashboard-grid,.rca-grid{grid-template-columns:1fr}.repo-meta{display:none}}\n@media(max-width:760px){.app{display:block}.sidebar{position:fixed;left:-265px;z-index:30;width:248px;transition:.2s}.sidebar.open{left:0}.mobile-overlay.show{display:block;position:fixed;inset:0;background:#07142699;z-index:25}.menu-btn{display:block}.topbar{padding:0 16px}.search{display:none}.content{padding:22px 16px}.heading{display:block}.heading .primary{margin-top:14px}.stats{grid-template-columns:1fr 1fr;gap:11px}.stat{padding:15px}.stat strong{font-size:21px}.repo-hero{align-items:flex-start}.pipeline{justify-content:flex-start}.incident-top{flex-wrap:wrap}.incident-actions{margin-left:58px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}\n@media(max-width:440px){.stats{grid-template-columns:1fr}.top-actions .icon-btn{display:none}.quick{grid-template-columns:1fr}.incident-actions{margin-left:0}}\n</style>\n</head>\n<body>\n<div class='mobile-overlay' id='overlay'></div>\n<div class='app'>\n<aside class='sidebar' id='sidebar'>\n <div class='brand'><div class='brand-mark'>N</div>Northstar <span class='prototype'>Prototype</span></div>\n <div class='nav-label'>Customer portal</div>\n <nav class='nav'>\n  <button class='active' data-page='dashboard'><span class='icon'>⌂</span>Overview</button>\n  <button data-page='accounts'><span class='icon'>▤</span>My